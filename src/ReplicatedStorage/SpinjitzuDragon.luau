-- SpinjitzuDragon v18.0  (ModuleScript in ReplicatedStorage)
-- Elemental dragon that appears behind the character after Spinjitzu (Rising Dragon), built from
-- plain parts like the show's energy dragons: solid-looking panels in the element colour with thin
-- glowing outlines. One tall column behind you: a cap-shaped faceted head on top (V seams down
-- its back, brow plates, an open mouth with white light inside, white eyes), a collar, then a
-- neck, body and long pointed tail of chevron plates down your back, and bat wings out to the
-- sides (straight top edge with a little W by the body, scalloped bottom) that beat. Energy
-- streaks fly off it, long drips hang off the wings, and a faint column of energy shines below
-- you while you rise. The shapes are DragonModel (generated by tools/dragon). Every piece is one
-- anchored part with the rest welded to it. Rendered on every client; colours from the element.

local Config = require(script.Parent:WaitForChild("SpinjitzuConfig"))
local Model = require(script.Parent:WaitForChild("DragonModel"))
local DragonNeck = require(script.Parent:WaitForChild("DragonNeck"))
local Powers = require(script.Parent:WaitForChild("ElementPowers"))
local Players = game:GetService("Players")

local Dragon = {}
Dragon.__index = Dragon

local WHITE = Color3.new(1, 1, 1)
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function lerp(a, b, t) return a + (b - a) * t end
local function smoothstep(e0, e1, x)
	local t = math.clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end
local function approach(v, target, step)
	if v < target then return math.min(target, v + step) end
	return math.max(target, v - step)
end
local function kp(t, v) return NumberSequenceKeypoint.new(t, v) end
-- the rotation that turns direction a onto direction b (both unit)
local function rotBetween(a, b)
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-6 then return CFrame.identity end
	return CFrame.fromAxisAngle(axis.Unit, math.acos(math.clamp(a:Dot(b), -1, 1)))
end

local function make(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		pcall(function() inst[k] = v end)
	end
	inst.Parent = parent
	return inst
end

local function newPart(className, parent, props)
	local p = Instance.new(className)
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	p.Transparency = 1
	for k, v in pairs(props) do
		pcall(function() p[k] = v end)
	end
	p.Parent = parent
	return p
end

-- two wedges filling triangle a,b,c (all points in the same local space)
local function triangle(a, b, c, thick)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	return {
		{ CFrame.fromMatrix((a + b) / 2, right, up, back), Vector3.new(thick, height, math.abs(ab:Dot(back))) },
		{ CFrame.fromMatrix((a + c) / 2, -right, up, -back), Vector3.new(thick, height, math.abs(ac:Dot(back))) },
	}
end


-- character poses while the dragon is out (same joint space as SpinjitzuEffect)
local POSE_JOINTS = { RightShoulder = true, LeftShoulder = true, RightHip = true, LeftHip = true, Waist = true }
local JOINT_ALIAS = { RootJoint = "Root" }
-- superhero hover (Iron Man style): both arms down, held out from your sides and back a little,
-- chest out, feet apart. Flying, the arms sweep back along your sides, legs together.
local HOVER_POSE = {
	RightShoulder = CFrame.Angles(-0.3, 0, 0.5),
	LeftShoulder  = CFrame.Angles(-0.3, 0, -0.5),
	RightHip      = CFrame.Angles(0, 0, 0.12),
	LeftHip       = CFrame.Angles(0, 0, -0.12),
}
local FLY_POSE = {
	RightShoulder = CFrame.Angles(-0.45, 0, 0.28),
	LeftShoulder  = CFrame.Angles(-0.45, 0, -0.28),
	RightHip      = CFrame.Angles(-0.12, 0, 0.03),
	LeftHip       = CFrame.Angles(-0.12, 0, -0.03),
}

local function getFxFolder()
	local f = workspace:FindFirstChild("SpinjitzuFX")
	if not f then
		f = Instance.new("Folder")
		f.Name = "SpinjitzuFX"
		f.Parent = workspace
	end
	return f
end

function Dragon.new(character, color, highlight, elementName)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local preset = elementName and Config.Presets[elementName] or {}

	local self = setmetatable({}, Dragon)
	self.character, self.root = character, root
	self.c = typeof(color) == "Color3" and color or Config.Color
	self.hi = typeof(highlight) == "Color3" and highlight or self.c:Lerp(WHITE, 0.5)
	self.deep = preset.Deep or self.c:Lerp(Color3.new(0, 0, 0), 0.45)
	self.kind = preset.Base or "default"
	self.elementName = elementName
	-- Neon washes pale colours out to white, so the dragon uses a saturated version of the hue
	local h, s, v = self.c:ToHSV()
	self.glowCol = Color3.fromHSV(h, math.max(s, 0.65), math.max(v, 0.85))
	self.flakeCol = Color3.fromHSV(h, 0.9, 0.85)
	self.flakeDark = Color3.fromHSV(h, 0.95, 0.55)
	-- see-through blocks + wings, bright edges + bones, white glow inside (presets can override)
	-- two shades: the body + head in a deeper shade, the wings in a lighter one
	self.plateCol = preset.DragonPlate or Color3.fromHSV(h, math.max(s, 0.8), 0.75)
	self.wingCol = preset.DragonWing or Color3.fromHSV(h, math.max(s, 0.8) * 0.75, 1)
	self.toothCol = preset.DragonTeeth or self.plateCol
	self.eyeCol = preset.DragonEye or WHITE:Lerp(self.glowCol, 0.15)
	self.boneCol = preset.DragonBone or self.plateCol
	self.edgeCol = preset.DragonEdge or self.wingCol:Lerp(WHITE, 0.3)
	self.coreCol = WHITE:Lerp(self.glowCol, 0.15)
	local okScale, modelScale = pcall(function() return character:GetScale() end)
	self.sc = (Config.DragonScale or 1) * (okScale and modelScale or 1)
	self.ws = self.sc * (Config.DragonWingScale or 1)
	self.t, self.flapT = 0, 0
	self.alpha, self.flyBlend, self.effort = 0, 0, 0
	self.vel = Vector3.zero
	self.phase = "rise"
	self.alive, self.stopping = true, false
	self.fadeParts, self.fadeBeams, self.emitters, self.trails = {}, {}, {}, {}

	self.motors = {}
	for _, m in ipairs(character:GetDescendants()) do
		local isMotor, isAnim = m:IsA("Motor6D"), m:IsA("AnimationConstraint")
		if isMotor or isAnim then
			local key = (m.Name:gsub(" ", ""))
			key = JOINT_ALIAS[key] or key
			local c0 = isMotor and m.C0 or (m.Attachment0 and m.Attachment0.CFrame)
			if POSE_JOINTS[key] and c0 then self.motors[key] = { motor = m, rot = c0.Rotation } end
		end
	end

	self.folder = Instance.new("Model")
	self.folder.Name = "Dragon_" .. character.Name
	self.anchor = newPart("Part", self.folder, { Name = "Anchor", Size = Vector3.new(0.2, 0.2, 0.2) })
	self.anchor.CFrame = root.CFrame

	self:_buildBody()
	self:_buildAura()

	self:_muteSteps()

	self.folder.Parent = getFxFolder()
	self:Update(0)
	return self
end

function Dragon:_emitter(parent, props)
	props.LightInfluence = 0
	local pe = make("ParticleEmitter", props, parent)
	table.insert(self.emitters, pe)
	return pe
end

function Dragon:_fadePart(part, base)
	table.insert(self.fadeParts, { part, base })
end

function Dragon:_fadeBeam(beam, base)
	table.insert(self.fadeBeams, { beam, base })
end

function Dragon:_piece(name)
	local root = newPart("Part", self.folder, { Name = name, Size = Vector3.new(0.2, 0.2, 0.2) })
	table.insert(self.roots, root)
	return root
end

-- a part on a piece at cf (piece space); base = its transparency once faded in
function Dragon:_add(root, className, cf, size, color, base, material)
	local p = newPart(className, self.folder, { Size = size, Color = color, Material = material or Enum.Material.Neon })
	p.CFrame = root.CFrame * cf
	p.Anchored, p.Massless = false, true
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = root, p
	w.Parent = p
	self:_fadePart(p, base)
	return p
end

-- a piece from DragonModel: soft glowing panels (no outlines), white light blocks (eyes, inside
-- the mouth)
-- soft glowing mist in the dragon's colour (world space, so it trails when flying)
function Dragon:_mist(parent, size)
	self:_emitter(parent, {
		Texture = TEX_SMOKE, Color = ColorSequence.new(self.glowCol, self.edgeCol), LightEmission = 0.8, Brightness = 2,
		Size = NumberSequence.new({ kp(0, 0.7 * size), kp(1, 1.8 * size) }),
		Transparency = NumberSequence.new({ kp(0, 1), kp(0.25, 0.5), kp(1, 1) }),
		Lifetime = NumberRange.new(0.8, 1.4), Rate = 9, Speed = NumberRange.new(0.5, 2),
		SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, 2, 0), Drag = 1,
		Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-40, 40),
	})
end

-- a ribbon of light that trails behind a point as it moves
function Dragon:_trail(att, width, life)
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position, a1.Position = att.Position + Vector3.new(0, width / 2, 0), att.Position - Vector3.new(0, width / 2, 0)
	a0.Parent, a1.Parent = att.Parent, att.Parent
	local tr = make("Trail", {
		Attachment0 = a0, Attachment1 = a1, Lifetime = life, MinLength = 0.05, FaceCamera = true,
		LightEmission = 1, LightInfluence = 0, Brightness = 3,
		Color = ColorSequence.new(self.edgeCol, self.wingCol),
		Transparency = NumberSequence.new({ kp(0, 0.2), kp(1, 1) }),
		WidthScale = NumberSequence.new({ kp(0, 1), kp(1, 0) }),
	}, att.Parent)
	table.insert(self.trails, tr)
	-- orbiters move their attachment: keep the pair on it
	return tr, a0, a1
end

-- an invisible box on a piece (particles come out of all over it)
function Dragon:_volume(root, cf, size)
	local p = newPart("Part", self.folder, { Name = "FxVolume", Size = size })
	p.CFrame = root.CFrame * cf
	p.Anchored, p.Massless = false, true
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = root, p
	w.Parent = p
	return p
end

local function beamLine(a0, a1, width, color, parent)
	return make("Beam", {
		Attachment0 = a0, Attachment1 = a1, FaceCamera = true, Segments = 1,
		LightEmission = 1, LightInfluence = 0, Brightness = 4,
		Width0 = width, Width1 = width, Color = ColorSequence.new(color),
		Transparency = NumberSequence.new(1),
	}, parent)
end

-- crackling arcs of energy jumping round the dragon: each one a zigzag of beams that flashes for a
-- moment somewhere new
local ARC_POINTS = 5
function Dragon:_buildArcs()
	self.arcs, self.arcClock = {}, 0
	for i = 1, 6 do
		local pts, beams = {}, {}
		for k = 1, ARC_POINTS do
			pts[k] = Instance.new("Attachment")
			pts[k].Parent = self.anchor
		end
		for k = 1, ARC_POINTS - 1 do
			beams[k] = beamLine(pts[k], pts[k + 1], 0.09 * self.sc, k % 2 == 0 and WHITE or self.edgeCol, self.anchor)
		end
		self.arcs[i] = { pts = pts, beams = beams, life = 0 }
	end
end

local function rnd(a, b) return a + math.random() * (b - a) end

function Dragon:_updateArcs(dt, a, effort)
	local sc = self.sc
	self.arcClock -= dt
	if self.arcClock <= 0 and not self.stopping then
		self.arcClock = rnd(0.04, 0.12) / (0.5 + effort)
		local arc
		for _, c in ipairs(self.arcs) do
			if c.life <= 0 then arc = c break end
		end
		if arc then
			-- somewhere on the body or out along a wing, jumping 2-4.5 studs
			local side = math.random() < 0.5 and 1 or -1
			local p0 = math.random() < 0.5 and Vector3.new(rnd(-1.5, 1.5), rnd(-4, 5), rnd(0.5, 2.5))
				or Vector3.new(side * rnd(2, 9.5), rnd(-1.5, 3.5), rnd(0.8, 2.2))
			local dir = Vector3.new(rnd(-1, 1), rnd(-1, 1), rnd(-0.4, 0.4))
			dir = dir.Magnitude > 0.05 and dir.Unit or Vector3.yAxis
			local p1 = p0 + dir * rnd(2, 4.5)
			local side2 = dir:Cross(Vector3.zAxis)
			side2 = side2.Magnitude > 0.05 and side2.Unit or Vector3.xAxis
			for k, att in ipairs(arc.pts) do
				local u = (k - 1) / (ARC_POINTS - 1)
				local kink = (k == 1 or k == ARC_POINTS) and 0 or rnd(-0.6, 0.6)
				att.Position = (p0:Lerp(p1, u) + side2 * kink) * sc
			end
			arc.life = rnd(0.06, 0.14)
			arc.shown = nil
		end
	end
	for _, arc in ipairs(self.arcs) do
		local show = arc.life > 0 and a or 0
		arc.life -= dt
		if show ~= arc.shown then
			arc.shown = show
			for _, b in ipairs(arc.beams) do b.Transparency = NumberSequence.new(1 - 0.95 * show) end
		end
	end
end

-- rings of energy rippling out from the dragon and falling away below it (behind it when flying)
local RING_SIDES, RING_COUNT, RING_TIME = 14, 3, 0.9
function Dragon:_buildRings()
	self.rings = {}
	for i = 1, RING_COUNT do
		local pts, beams = {}, {}
		for k = 1, RING_SIDES do
			pts[k] = Instance.new("Attachment")
			pts[k].Parent = self.anchor
		end
		for k = 1, RING_SIDES do
			beams[k] = beamLine(pts[k], pts[k % RING_SIDES + 1], 0.3 * self.sc, self.edgeCol, self.anchor)
		end
		self.rings[i] = { pts = pts, beams = beams, offset = (i - 1) / RING_COUNT }
	end
end

function Dragon:_updateRings(a, effort)
	local sc = self.sc
	for _, r in ipairs(self.rings) do
		local u = (self.t / RING_TIME + r.offset) % 1
		local radius = lerp(1.2, 6.5, smoothstep(0, 1, u)) * sc
		local y = lerp(-1, -7, u) * sc
		local spin = self.t * 1.5 + r.offset * 6
		for k, att in ipairs(r.pts) do
			local ang = spin + (k - 1) / RING_SIDES * math.pi * 2
			att.Position = Vector3.new(math.cos(ang) * radius, y, 0.9 * sc + math.sin(ang) * radius)
		end
		local vis = a * lerp(0.35, 1, effort) * (1 - u) * math.min(1, u * 6)
		local width = lerp(0.4, 0.08, u) * sc
		for _, b in ipairs(r.beams) do
			b.Transparency = NumberSequence.new(1 - 0.9 * vis)
			b.Width0, b.Width1 = width, width
		end
	end
end

-- green-flame wisps licking up off it (fire texture in the dragon's two shades)
function Dragon:_flames(parent, size)
	return self:_emitter(parent, {
		Texture = TEX_FIRE, Color = ColorSequence.new(self.wingCol, self.plateCol), LightEmission = 1, Brightness = 3,
		Size = NumberSequence.new({ kp(0, 0.9 * size), kp(0.5, 1.3 * size), kp(1, 0.3 * size) }),
		Transparency = NumberSequence.new({ kp(0, 0.6), kp(0.2, 0.15), kp(1, 1) }),
		Lifetime = NumberRange.new(0.5, 1.0), Rate = 22, Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, 8, 0), Drag = 1,
		Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-120, 120),
	})
end

function Dragon:_facets(root, data, scale, color, bones)
	local tr = data.tris or {}
	for i = 1, #tr, 9 do
		local a = Vector3.new(tr[i], tr[i + 1], tr[i + 2]) * scale
		local b = Vector3.new(tr[i + 3], tr[i + 4], tr[i + 5]) * scale
		local c = Vector3.new(tr[i + 6], tr[i + 7], tr[i + 8]) * scale
		if (b - a):Cross(c - a).Magnitude > 1e-6 then
			for _, w in ipairs(triangle(a, b, c, 0.05 * scale)) do
				self:_add(root, "WedgePart", w[1], w[2], color or self.plateCol, 0.2)
			end
		end
	end
	-- bones across the wings (the thicker lines in the data), in the darker shade: no glowing outlines
	if bones then
		local e = data.edges or {}
		for i = 1, #e, 7 do
			local a = Vector3.new(e[i], e[i + 1], e[i + 2]) * scale
			local b = Vector3.new(e[i + 3], e[i + 4], e[i + 5]) * scale
			local th = e[i + 6] * scale * 1.8
			if e[i + 6] >= 0.07 and (b - a).Magnitude > 1e-4 then
				self:_add(root, "Part", CFrame.lookAt((a + b) / 2, b), Vector3.new(th, th, (b - a).Magnitude + th), self.boneCol, 0)
			end
		end
	end
	-- solid teeth
	local tt = data.teeth or {}
	for i = 1, #tt, 9 do
		local a = Vector3.new(tt[i], tt[i + 1], tt[i + 2]) * scale
		local b = Vector3.new(tt[i + 3], tt[i + 4], tt[i + 5]) * scale
		local c = Vector3.new(tt[i + 6], tt[i + 7], tt[i + 8]) * scale
		if (b - a):Cross(c - a).Magnitude > 1e-6 then
			for _, w in ipairs(triangle(a, b, c, 0.06 * scale)) do
				self:_add(root, "WedgePart", w[1], w[2], self.toothCol, 0)
			end
		end
	end
	-- white light: blocks, oval eyes (a sphere mesh stretched), and flat triangles (inside the mouth)
	for _, g in ipairs(data.glow or {}) do
		local tilt = g[3]
		local p = self:_add(root, "Part", CFrame.new(g[1] * scale) * CFrame.Angles(tilt.X, tilt.Y, tilt.Z), g[2] * scale, g[5] == "oval" and self.eyeCol or self.coreCol, g[4])
		if g[5] == "mouth" then
			-- the inside of the mouth: only lit while it's open (see Update)
			table.insert(self.mouthParts, table.remove(self.fadeParts))
		elseif g[5] == "oval" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		end
	end
	local gt = data.gtris or {}
	for i = 1, #gt, 9 do
		local a = Vector3.new(gt[i], gt[i + 1], gt[i + 2]) * scale
		local b = Vector3.new(gt[i + 3], gt[i + 4], gt[i + 5]) * scale
		local c = Vector3.new(gt[i + 6], gt[i + 7], gt[i + 8]) * scale
		if (b - a):Cross(c - a).Magnitude > 1e-6 then
			for _, w in ipairs(triangle(a, b, c, 0.04 * scale)) do
				self:_add(root, "WedgePart", w[1], w[2], self.coreCol, 0)
			end
		end
	end
end

function Dragon:_buildBody()
	local M, sc, ws = Model, self.sc, self.ws
	self.roots = {}
	self.hs = sc * M.HeadScale * (Config.DragonHeadScale or 1)
	-- the column: neck, body and tail down your back
	self.body = self:_piece("Body")
	self:_facets(self.body, M.Body, sc)
	-- the tail: a chain of segments that swing (see _placeTail)
	self.tail = {}
	for i, seg in ipairs(M.Tail) do
		local root = self:_piece("Tail")
		self:_facets(root, seg, sc)
		self.tail[i] = { root = root, rest = M.TailJoints[i] * sc, len = (M.TailJoints[i + 1] - M.TailJoints[i]).Magnitude * sc }
	end
	self.tailTip = M.TailJoints[#M.TailJoints] * sc
	local tip = Instance.new("Attachment")
	tip.Position = M.TailJoints[#M.TailJoints] - M.TailJoints[#M.Tail]
	tip.Position *= sc
	tip.Parent = self.tail[#self.tail].root
	self:_flames(tip, sc)
	self:_trail(tip, 0.5 * sc, 0.45)
	-- the neck: segments that bend so the head can look where your power goes (see DragonNeck)
	self.neck = {}
	for i, seg in ipairs(M.Neck) do
		self.neck[i] = self:_piece("Neck")
		self:_facets(self.neck[i], seg, sc)
	end
	self.look = Vector3.yAxis
	-- the head on top
	self.mouthParts = {}
	self.head = self:_piece("Head")
	self:_facets(self.head, M.Head, self.hs)
	-- the lower jaw: shut, swings open while you use your power
	self.jaw = self:_piece("Jaw")
	self:_facets(self.jaw, M.Jaw, self.hs)
	self.jawT = 0
	self.headFx = Instance.new("Attachment")
	self.headFx.Parent = self.head
	self.headFx.Position = Vector3.new(0, 0, -2 * self.hs)
	-- the light inside the open mouth spills out
	local glow = Instance.new("Attachment")
	glow.Position = Vector3.new(0, -0.65, -1.6) * self.hs
	glow.Parent = self.head
	self.headLight = make("PointLight", { Color = self.coreCol, Brightness = 1.5, Range = 10 * sc, Shadows = false }, glow)
	-- energy boiling in the throat: a pulsing ball of light + sparks spilling out of the mouth
	self.mouthFx = {}
	self.throat = self:_emitter(glow, {
		Texture = TEX_SPARK, Color = ColorSequence.new(WHITE, self.wingCol), LightEmission = 1, Brightness = 5,
		Size = NumberSequence.new({ kp(0, 1.4 * self.hs), kp(0.5, 1.9 * self.hs), kp(1, 0.6 * self.hs) }),
		Transparency = NumberSequence.new({ kp(0, 0.5), kp(0.5, 0.2), kp(1, 1) }),
		Lifetime = NumberRange.new(0.25, 0.4), Rate = 14, Speed = NumberRange.new(0), LockedToPart = true,
		Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-300, 300),
	})
	self.mouthFx[1] = self:_emitter(glow, {
		Texture = TEX_SPARK, Color = ColorSequence.new(self.edgeCol, self.wingCol), LightEmission = 1, Brightness = 4,
		Size = NumberSequence.new({ kp(0, 0.25 * self.hs), kp(1, 0) }),
		Lifetime = NumberRange.new(0.3, 0.6), Rate = 30, Speed = NumberRange.new(2 * sc, 6 * sc),
		EmissionDirection = Enum.NormalId.Front, SpreadAngle = Vector2.new(40, 40), Drag = 2,
	})
	self.mouthFx[2] = self:_flames(glow, 0.8 * self.hs)
	-- the eyes leave streaks of light behind them
	for _, sx in ipairs({ 1, -1 }) do
		local eye = Instance.new("Attachment")
		eye.Position = Vector3.new(sx * 1.25, 0.5, -1.38) * self.hs
		eye.Parent = self.head
		self:_trail(eye, 0.22 * self.hs, 0.35)
		self:_emitter(eye, {
			Texture = TEX_SPARK, Color = ColorSequence.new(self.eyeCol), LightEmission = 1, Brightness = 4,
			Size = NumberSequence.new({ kp(0, 0.5 * self.hs), kp(1, 0) }), Lifetime = NumberRange.new(0.15, 0.3),
			Rate = 12, Speed = NumberRange.new(0), LockedToPart = true,
		})
	end
	-- wings (the same part both sides; the left one is turned round when it's placed)
	self.wings, self.drips = {}, {}
	for _, side in ipairs({ 1, -1 }) do
		local wing = self:_piece("Wing")
		self:_facets(wing, M.Wing, ws, self.wingCol, true)
		local function point(name)
			local a = Instance.new("Attachment")
			a.Position = M.WingPoints[name] * ws
			a.Parent = wing
			return a
		end
		-- long drips of energy hanging straight down off the wing (the bottom end is placed each frame)
		for _, name in ipairs(M.WingDrips) do
			self:_mist(point(name), sc)
			self:_flames(point(name), sc)
		end
		self:_flames(point("W"), sc)
		self:_trail(point("Wx"), 0.6 * ws, 0.4)
		self:_trail(point("Tb"), 0.6 * ws, 0.4)
		for _, name in ipairs(M.WingDrips) do
			local top = point(name)
			local bottom = Instance.new("Attachment")
			bottom.Parent = self.anchor
			local beam = make("Beam", {
				Attachment0 = top, Attachment1 = bottom, FaceCamera = true, Segments = 1,
				LightEmission = 0.8, LightInfluence = 0, Brightness = 2,
				Width0 = 0.16 * sc, Width1 = 0.04 * sc, Color = ColorSequence.new(self.edgeCol, self.plateCol),
				Transparency = NumberSequence.new(1),
			}, top)
			table.insert(self.drips, { top = top, bottom = bottom, beam = beam, len = (3.5 + math.random() * 2) * sc, phase = math.random() * 6 })
		end
		-- sparkles all over the membrane
		self:_emitter(self:_volume(wing, CFrame.new(4.2 * ws, -0.8 * ws, 0), Vector3.new(8.5, 4.2, 0.2) * ws), {
			Texture = TEX_SPARK, Color = ColorSequence.new(self.edgeCol, self.wingCol), LightEmission = 1, Brightness = 4,
			Size = NumberSequence.new({ kp(0, 0), kp(0.3, 0.3 * ws), kp(1, 0) }),
			Lifetime = NumberRange.new(0.4, 0.9), Rate = 40, Speed = NumberRange.new(0.2, 1.5),
			SpreadAngle = Vector2.new(180, 180), Rotation = NumberRange.new(0, 360),
		})
		self.wings[side] = wing
	end
	-- and over the body + neck
	self:_emitter(self:_volume(self.body, CFrame.new(0, 1.5 * sc, 1.5 * sc), Vector3.new(3, 7, 2) * sc), {
		Texture = TEX_SPARK, Color = ColorSequence.new(self.edgeCol, self.plateCol), LightEmission = 1, Brightness = 4,
		Size = NumberSequence.new({ kp(0, 0), kp(0.3, 0.35 * sc), kp(1, 0) }),
		Lifetime = NumberRange.new(0.4, 0.9), Rate = 35, Speed = NumberRange.new(0.5, 2),
		SpreadAngle = Vector2.new(180, 180), Rotation = NumberRange.new(0, 360),
	})
	self:_buildArcs()
	self:_buildRings()

	-- streaks of energy flying off in every direction
	local mid = Instance.new("Attachment")
	mid.Position = Vector3.new(0, 1.5 * sc, 1 * sc)
	mid.Parent = self.anchor
	self:_emitter(mid, {
		Texture = TEX_SPARK, Color = ColorSequence.new(self.edgeCol, self.glowCol), LightEmission = 1, Brightness = 4,
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Size = NumberSequence.new({ kp(0, 0.22 * sc), kp(1, 0.08 * sc) }),
		Squash = NumberSequence.new(2.5),
		Transparency = NumberSequence.new({ kp(0, 0.1), kp(0.7, 0.3), kp(1, 1) }),
		Lifetime = NumberRange.new(0.3, 0.55), Rate = 55, Speed = NumberRange.new(22 * sc, 40 * sc),
		SpreadAngle = Vector2.new(180, 180), Drag = 2,
	})
	-- wisps of energy spiralling round the dragon, leaving trails
	self.orbiters = {}
	for i = 1, 3 do
		local a = Instance.new("Attachment")
		a.Parent = self.anchor
		local _, t0, t1 = self:_trail(a, 0.35 * sc, 0.6)
		self:_emitter(a, {
			Texture = TEX_SPARK, Color = ColorSequence.new(self.edgeCol, self.wingCol), LightEmission = 1, Brightness = 3,
			Size = NumberSequence.new({ kp(0, 0.35 * sc), kp(1, 0) }), Lifetime = NumberRange.new(0.3, 0.6),
			Rate = 25, Speed = NumberRange.new(0.5, 2), SpreadAngle = Vector2.new(180, 180),
		})
		self.orbiters[i] = { att = a, t0 = t0, t1 = t1, phase = (i - 1) * math.pi * 2 / 3 }
	end
	-- motes of light floating up all round it
	local motes = Instance.new("Attachment")
	motes.Position = Vector3.new(0, 1, 1) * sc
	motes.Parent = self.anchor
	self:_emitter(motes, {
		Texture = TEX_SPARK, Color = ColorSequence.new(self.edgeCol, self.wingCol), LightEmission = 1, Brightness = 3,
		Size = NumberSequence.new({ kp(0, 0.25 * sc), kp(0.5, 0.35 * sc), kp(1, 0) }),
		Transparency = NumberSequence.new({ kp(0, 0.2), kp(1, 1) }),
		Lifetime = NumberRange.new(1, 2), Rate = 45, Speed = NumberRange.new(2 * sc, 6 * sc),
		SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, 3, 0), Drag = 1.5,
	})
	-- mist along the body
	for _, y in ipairs({ 1, -1.5, -4 }) do
		local a = Instance.new("Attachment")
		a.Position = Vector3.new(0, y, Model.NeckTop.Z) * sc
		a.Parent = self.body
		self:_mist(a, 1.2 * sc)
		self:_flames(a, 1.3 * sc)
	end
	do -- (and up the neck)
		local a = Instance.new("Attachment")
		a.Parent = self.neck[2]
		self:_mist(a, 1.2 * sc)
		self:_flames(a, 1.3 * sc)
	end
	-- speed lines streaming off you when you boost (Shift)
	-- (a box round you, turned each frame so its top faces backwards)
	self.speedBox = newPart("Part", self.folder, { Name = "FxVolume", Size = Vector3.new(14, 6, 12) * sc })
	self.speedLines = self:_emitter(self.speedBox, {
		Texture = TEX_SPARK, Color = ColorSequence.new(WHITE, self.edgeCol), LightEmission = 1, Brightness = 3,
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Size = NumberSequence.new({ kp(0, 0.15 * sc), kp(1, 0.05 * sc) }), Squash = NumberSequence.new(6),
		Transparency = NumberSequence.new({ kp(0, 0.3), kp(1, 1) }),
		Lifetime = NumberRange.new(0.2, 0.35), Rate = 0, Speed = NumberRange.new(60),
		EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(4, 4),
	})
	-- streaks raining down / spraying out below it
	local below = Instance.new("Attachment")
	below.Position = Vector3.new(0, -1.5 * sc, Model.NeckTop.Z * sc)
	below.Parent = self.anchor
	self:_emitter(below, {
		Texture = TEX_SPARK, Color = ColorSequence.new(self.edgeCol, self.plateCol), LightEmission = 1, Brightness = 3,
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Size = NumberSequence.new({ kp(0, 0.3 * sc), kp(1, 0.1 * sc) }),
		Squash = NumberSequence.new(3),
		Transparency = NumberSequence.new({ kp(0, 0.1), kp(0.7, 0.4), kp(1, 1) }),
		Lifetime = NumberRange.new(0.5, 0.8), Rate = 70, Speed = NumberRange.new(16 * sc, 28 * sc),
		EmissionDirection = Enum.NormalId.Bottom, SpreadAngle = Vector2.new(35, 35), Drag = 1,
	})
	-- rising: a bright column of energy below you
	local top, bottom = Instance.new("Attachment"), Instance.new("Attachment")
	top.Position = Vector3.new(0, -2 * sc, 0.3 * sc)
	bottom.Position = Vector3.new(0, -32 * sc, 0.3 * sc)
	top.Parent, bottom.Parent = self.anchor, self.anchor
	self.column = {}
	for _, w in ipairs({ { 0.5, 0.35, self.edgeCol }, { 1.5, 0.8, self.plateCol } }) do -- core, glow (faint)
		table.insert(self.column, { base = w[2], beam = make("Beam", {
			Attachment0 = top, Attachment1 = bottom, FaceCamera = true, Segments = 1,
			LightEmission = 1, LightInfluence = 0, Brightness = 3,
			Width0 = w[1] * sc, Width1 = w[1] * 0.35 * sc, Color = ColorSequence.new(w[3]),
			Transparency = NumberSequence.new(1),
		}, self.anchor) })
	end
	self.columnOn = 0
end

-- where every piece goes this frame (added to the BulkMoveTo lists)
function Dragon:_placeBody(rootCF, flap, effort, beat, parts, cfs)
	local M = Model
	local t, sc = self.t, self.sc
	local function put(root, cf)
		table.insert(parts, root)
		table.insert(cfs, cf)
	end
	put(self.body, rootCF)
	-- neck + head: up the column, bending round to look where your power goes, bobbing a little
	local chain = DragonNeck.Bend(M, self.look)
	for i, seg in ipairs(self.neck) do
		put(seg, rootCF * CFrame.new(chain[i].pos * sc) * chain[i].rot)
	end
	local top = chain[#chain]
	local headCF = rootCF * CFrame.new(top.pos * sc) * top.rot
		* CFrame.Angles(M.HeadPitch + math.sin(t * 2) * 0.05 + beat * 0.04 * effort, math.sin(t * 0.7) * 0.08, 0)
	put(self.head, headCF)
	local hinge = M.JawHinge * self.hs
	local open = M.JawOpen * smoothstep(0, 1, self.jawT)
	put(self.jaw, headCF * CFrame.new(hinge) * CFrame.Angles(-open, 0, 0) * CFrame.new(-hinge))
	DragonNeck.Live[self.character] = headCF:PointToWorldSpace(M.MouthLocal * self.hs)
	-- wings beat about the hinge at the shoulder
	for side, wing in pairs(self.wings) do
		local hinge = CFrame.new(side * M.Hinge.X * sc, M.Hinge.Y * sc, M.Hinge.Z * sc)
			* CFrame.Angles(0, -side * M.HingeYaw, 0) * CFrame.Angles(0, 0, side * (M.WingRaise + flap))
		put(wing, rootCF * hinge * (side < 0 and CFrame.Angles(0, math.pi, 0) or CFrame.identity))
	end
	-- tail: each joint springs toward where it should be (swaying a little), so the tail swings and
	-- lags behind when you turn or speed up; every segment keeps its length
	local dt = math.min(self.dt or 0, 1 / 20)
	local n = #self.tail
	local points = { rootCF * self.tail[1].rest } -- (the top of the tail stays on the body)
	self.tailPos, self.tailVel = self.tailPos or {}, self.tailVel or {}
	for i = 1, n do
		local restLocal = i < n and self.tail[i + 1].rest or self.tailTip
		local f = i / n
		local sway = Vector3.new(math.sin(t * 2.2 - i * 0.8) * 0.45 * f, 0, math.cos(t * 1.7 - i * 0.6) * 0.2 * f) * sc
		local want = rootCF * (restLocal + sway)
		local pos, vel = self.tailPos[i], self.tailVel[i]
		if not pos or (pos - want).Magnitude > 25 * sc then pos, vel = want, Vector3.zero end
		vel += ((want - pos) * 70 - vel * 11) * dt
		pos += vel * dt
		local d = pos - points[i]
		if d.Magnitude > 1e-3 then pos = points[i] + d.Unit * self.tail[i].len end
		self.tailPos[i], self.tailVel[i] = pos, vel
		points[i + 1] = pos
	end
	for i, seg in ipairs(self.tail) do
		local restDir = ((i < n and self.tail[i + 1].rest or self.tailTip) - seg.rest).Unit
		local nowDir = rootCF:VectorToObjectSpace(points[i + 1] - points[i]).Unit
		put(seg.root, rootCF * CFrame.new(rootCF:PointToObjectSpace(points[i])) * rotBetween(restDir, nowDir))
	end
	-- wisps spiralling round it
	for _, o in ipairs(self.orbiters) do
		local ang = t * 2.4 + o.phase
		local pos = Vector3.new(math.cos(ang) * 3.2, math.sin(t * 1.3 + o.phase) * 3.5 + 1, math.sin(ang) * 3.2 + 1.1) * sc
		local half = (o.t0.Position - o.t1.Position) / 2
		o.att.Position, o.t0.Position, o.t1.Position = pos, pos + half, pos - half
	end
	-- the column of energy under you while rising
	local want = (self.phase == "rise" and not self.stopping) and 1 or 0
	self.columnOn = approach(self.columnOn, want, (self.dt or 0) * (want > 0 and 3 or 1.5))
	local a = self.columnOn * self.alpha
	if a ~= self.columnA then
		self.columnA = a
		for _, c in ipairs(self.column) do
			c.beam.Transparency = NumberSequence.new({ kp(0, 1 - (1 - c.base) * a), kp(0.15, 1 - (1 - c.base) * a), kp(1, 1) })
		end
	end
end

function Dragon:_buildAura()
	local sc = self.sc
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, 0.5 * sc, 0.4 * sc)
	att.Parent = self.anchor
	self.aura = self:_emitter(att, {
		Texture = self.kind == "fire" and TEX_FIRE or TEX_SPARK,
		Color = ColorSequence.new(self.hi, self.flakeCol),
		LightEmission = 1, Brightness = 3,
		Size = NumberSequence.new({ kp(0, 0.4 * sc), kp(1, 0.1 * sc) }),
		Lifetime = NumberRange.new(0.4, 0.9), Rate = 22, Speed = NumberRange.new(3 * sc, 8 * sc),
		SpreadAngle = Vector2.new(180, 180), Drag = 2, Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-200, 200),
	})
	self.light = make("PointLight", { Color = self.plateCol, Brightness = 3, Range = 18 * sc, Shadows = false }, att)
	-- burst when the dragon appears
	task.defer(function()
		if self.aura and self.aura.Parent then self.aura:Emit(50) end
	end)
end

-- "rise" (going straight up), "fly" (free flight), "land" (bots coming back down)
function Dragon:SetPhase(phase)
	self.phase = phase
end

-- limb pose while the dragon is out; call after the Animator has run (RunService.Stepped)
function Dragon:ApplyPose()
	if not self.alive or not next(self.motors) then return end
	local w = smoothstep(0, 1, self.alpha)
	for key, j in pairs(self.motors) do
		local m = j.motor
		if m.Parent then
			local cur = m.Transform
			local base = (j.last and cur == j.last) and CFrame.identity or cur
			local out = base
			if w > 0.001 then
				local A, B = HOVER_POSE[key] or CFrame.identity, FLY_POSE[key] or CFrame.identity
				out = base:Lerp(j.rot:Inverse() * A:Lerp(B, self.flyBlend) * j.rot, w)
			end
			if out ~= cur then m.Transform = out end
			j.last = out
		end
	end
end

function Dragon:Stop()
	if self.stopping then return end
	self.stopping = true
	for _, pe in ipairs(self.emitters) do pe.Enabled = false end
	for _, tr in ipairs(self.trails) do tr.Enabled = false end
	-- it bursts into sparks as it goes
	if self.aura then self.aura:Emit(90) end
end

-- no footsteps / jump / landing sounds while you fly (the default character sounds live in the
-- root part; some are only made once you start moving, so catch those too)
local STEP_SOUNDS = { Running = true, Jumping = true, FreeFalling = true, Landing = true, Climbing = true,
	GettingUp = true, Died = false, Swimming = true, Splash = true }
function Dragon:_muteSteps()
	self.muted = {}
	local function mute(s)
		if s:IsA("Sound") and STEP_SOUNDS[s.Name] and not self.muted[s] then
			self.muted[s] = s.Volume
			s.Volume = 0
		end
	end
	for _, s in ipairs(self.root:GetChildren()) do mute(s) end
	self.muteConn = self.root.ChildAdded:Connect(mute)
	-- the character sound script may set the volume back while you move: keep it at 0
end

function Dragon:Destroy()
	if not self.alive then return end
	self.alive = false
	if self.muteConn then self.muteConn:Disconnect() end
	for s, vol in pairs(self.muted or {}) do
		if s.Parent then s.Volume = vol end
	end
	for _, j in pairs(self.motors) do
		if j.last and j.motor.Parent and j.motor.Transform == j.last then j.motor.Transform = CFrame.identity end
	end
	if DragonNeck.Live[self.character] then DragonNeck.Live[self.character] = nil end
	if self.folder then self.folder:Destroy() end
	self.folder = nil
end

function Dragon:Update(dt)
	if not self.alive then return false end
	if not self.root.Parent or not self.character.Parent then
		self:Destroy()
		return false
	end
	self.t += dt
	self.dt = dt
	local t, sc = self.t, self.sc

	-- fade in / out
	local prev = self.alpha
	self.alpha = approach(self.alpha, self.stopping and 0 or 1, dt / (self.stopping and 0.35 or 0.45))
	if self.stopping and self.alpha <= 0 then
		self:Destroy()
		return false
	end
	local a = self.alpha
	if a ~= prev or dt == 0 then
		for _, fp in ipairs(self.fadeParts) do fp[1].Transparency = 1 - (1 - fp[2]) * a end
		for _, fb in ipairs(self.fadeBeams) do fb[1].Transparency = NumberSequence.new(1 - (1 - fb[2]) * a) end
	end

	-- how fast are we really moving? (works for you, other players and bots alike)
	local rootCF = self.root.CFrame
	local pos = rootCF.Position
	if self.lastPos and dt > 0 then
		local v = (pos - self.lastPos) / dt
		if v.Magnitude < 400 then self.vel = self.vel:Lerp(v, math.min(1, dt * 6)) end
	end
	self.lastPos = pos
	local horiz = Vector3.new(self.vel.X, 0, self.vel.Z).Magnitude
	local speed = self.vel.Magnitude

	local flyTarget, effortTarget = 0, 0.3
	if self.phase == "rise" then
		effortTarget = 1
	elseif self.phase == "fly" then
		flyTarget = math.clamp(horiz / 25, 0, 1)
		effortTarget = math.max(0.3, math.clamp(speed / 20, 0, 1))
	elseif self.phase == "land" then
		effortTarget = 0.5
	end
	self.flyBlend = approach(self.flyBlend, flyTarget, dt * 2.5)
	self.effort = approach(self.effort, effortTarget, dt * 2)
	local effort = smoothstep(0, 1, self.effort)

	self.anchor.CFrame = rootCF

	-- wing beat: gentle flutter when hovering -> big flaps when climbing / flying
	self.flapT += dt * lerp(2.2, Config.DragonFlapSpeed or 6, effort)
	local beat = math.sin(self.flapT)
	local flap = beat * lerp(0.1, 0.35, effort) + 0.05 - (1 - smoothstep(0, 1, a)) * 1.0
	-- the head looks where your power goes (beaming, mouth open), else at whoever you're locked
	-- onto, else where your camera looks (other people's dragons: where they're flying); never
	-- further round than DragonNeck.MaxTurn
	local character = self.character
	local mine = character == Players.LocalPlayer.Character
	local beaming = character:GetAttribute("PowerBeam") == true or (mine and Powers.LocalAim ~= nil)
	local aim = beaming and character:GetAttribute("PowerAim")
	if mine and Powers.LocalAim then aim = Powers.LocalAim end
	local lock = character:FindFirstChild("DragonLock")
	local lockRoot = lock and lock:IsA("ObjectValue") and lock.Value and lock.Value:FindFirstChild("HumanoidRootPart")
	local center = DragonNeck.Center(self.phase == "fly" and smoothstep(0, 1, self.flyT or 0) or 0)
	local want
	if typeof(aim) == "Vector3" then
		want = DragonNeck.LookAt(Model, rootCF, sc, aim)
	elseif lockRoot then
		want = DragonNeck.LookAt(Model, rootCF, sc, lockRoot.Position)
	elseif mine and workspace.CurrentCamera then
		want = rootCF:VectorToObjectSpace(workspace.CurrentCamera.CFrame.LookVector)
	elseif speed > 5 then
		want = rootCF:VectorToObjectSpace(self.vel)
	else
		want = center
	end
	want = DragonNeck.Clamp(want, center)
	local look = self.look:Lerp(want, 1 - math.exp(-dt * 10))
	self.look = look.Magnitude > 0.05 and look.Unit or want
	self.flyT = approach(self.flyT or 0, self.phase == "fly" and 1 or 0, dt * 1.5)
	-- the jaw opens while you use your power
	self.jawT = approach(self.jawT, beaming and not self.stopping and 1 or 0, dt * (beaming and 7 or 4))
	local lit = a * smoothstep(0, 1, self.jawT)
	if math.abs(lit - (self.mouthLit or -1)) > 0.01 then
		self.mouthLit = lit
		for _, mp in ipairs(self.mouthParts) do mp[1].Transparency = 1 - (1 - mp[2]) * lit end
	end
	-- speed lines when you go faster than flying normally does (Shift)
	local boost = math.clamp((speed - (Config.DragonFlySpeed or 50) * 1.1) / 20, 0, 1)
	local parts, cfs = {}, {} -- moved together with one BulkMoveTo
	self.speedLines.Rate = self.stopping and 0 or 120 * boost
	if speed > 1 then
		local p = rootCF:PointToWorldSpace(Vector3.new(0, 1, 1) * sc)
		table.insert(parts, self.speedBox)
		table.insert(cfs, CFrame.lookAt(p, p - self.vel) * CFrame.Angles(-math.pi / 2, 0, 0)) -- (top = backwards)
	end
	self:_placeBody(rootCF, flap, effort, beat, parts, cfs)
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	-- drips hang straight down (world down), stretching a little
	for _, d in ipairs(self.drips) do
		local len = d.len * (0.85 + 0.15 * math.sin(t * 3 + d.phase))
		d.bottom.WorldPosition = d.top.WorldPosition - Vector3.new(0, len, 0)
		if a ~= d.a then
			d.a = a
			d.beam.Transparency = NumberSequence.new({ kp(0, 1 - 0.85 * a), kp(1, 1) })
		end
	end

	self:_updateArcs(dt, a, effort)
	self:_updateRings(a, effort)
	if self.throat then
		local open = self.stopping and 0 or smoothstep(0, 1, self.jawT)
		self.throat.Rate = (14 + 10 * math.sin(t * 9)) * open
		self.mouthFx[1].Rate, self.mouthFx[2].Rate = 30 * open, 22 * open
	end
	if self.light then
		self.light.Brightness = 2 * a * (0.85 + 0.15 * math.sin(t * 7))
	end
	if self.headLight then self.headLight.Brightness = 2.5 * (self.mouthLit or 0) end
	for s in pairs(self.muted) do
		if s.Volume ~= 0 then s.Volume = 0 end
	end
	return true
end

----------------------------------------------------------------------------------------
-- the landing: a superhero landing (one knee down, a fist on the floor, the other arm back) and
-- an impact for everyone to see: flash, shockwaves, cracks, flying rocks, dust, sparks
----------------------------------------------------------------------------------------

local LAND_POSE = { -- (Root drops you down + leans you forward)
	Root          = CFrame.new(0, -1.0, -0.25) * CFrame.Angles(-0.45, 0, 0),
	Waist         = CFrame.Angles(-0.15, 0, 0),
	RightHip      = CFrame.Angles(-0.75, 0, 0.05),   -- knee down behind you
	LeftHip       = CFrame.Angles(1.55, 0, -0.05),   -- foot planted in front
	RightShoulder = CFrame.Angles(0.7, 0, 0.12),     -- fist on the floor
	LeftShoulder  = CFrame.Angles(-0.6, 0, -0.9),    -- arm flung out back
}
local LAND_TIME = 1.1
local LAND_JOINTS = { Root = true, Waist = true, RightHip = true, LeftHip = true, RightShoulder = true, LeftShoulder = true }
local BOOM = "rbxassetid://73278613369675"

local Landing = {}
Landing.__index = Landing

local function tweenOut(inst, time, props)
	game:GetService("TweenService"):Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

function Dragon.Land(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local self = setmetatable({ character = character, t = 0, motors = {} }, Landing)
	for _, m in ipairs(character:GetDescendants()) do
		local isMotor, isAnim = m:IsA("Motor6D"), m:IsA("AnimationConstraint")
		if isMotor or isAnim then
			local key = (m.Name:gsub(" ", ""))
			key = JOINT_ALIAS[key] or key
			local c0 = isMotor and m.C0 or (m.Attachment0 and m.Attachment0.CFrame)
			if LAND_JOINTS[key] and c0 then self.motors[key] = { motor = m, rot = c0.Rotation } end
		end
	end

	-- the impact, where you hit the floor
	local element = character:GetAttribute("SpinjitzuElement")
	local preset = element and Config.Presets[element] or {}
	local col = preset.DragonWing or character:GetAttribute("SpinjitzuColor") or Config.Color
	local deep = preset.DragonPlate or col
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, getFxFolder() }
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -12, 0), params)
	local ground = hit and hit.Position or (root.Position - Vector3.new(0, 3, 0))
	local floorCol = hit and hit.Instance.Color or Color3.fromRGB(120, 120, 120)
	local folder = Instance.new("Folder")
	folder.Name = "DragonLanding"
	folder.Parent = getFxFolder()
	game:GetService("Debris"):AddItem(folder, 4)
	local function part(props)
		local p = newPart("Part", folder, props)
		return p
	end
	-- flash
	local flash = part({ Shape = Enum.PartType.Ball, Color = WHITE:Lerp(col, 0.3), Size = Vector3.new(2, 2, 2), Transparency = 0.1 })
	flash.CFrame = CFrame.new(ground + Vector3.new(0, 1, 0))
	tweenOut(flash, 0.3, { Size = Vector3.new(16, 16, 16), Transparency = 1 })
	-- shockwaves rushing out along the floor
	for i, w in ipairs({ { 0.35, 34, WHITE }, { 0.6, 26, col }, { 0.9, 18, deep } }) do
		local ring = part({ Shape = Enum.PartType.Cylinder, Color = w[3], Size = Vector3.new(0.15, 2, 2), Transparency = 0.15 })
		ring.CFrame = CFrame.new(ground + Vector3.new(0, 0.08 + i * 0.02, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		tweenOut(ring, w[1], { Size = Vector3.new(0.15, w[2], w[2]), Transparency = 1 })
	end
	-- cracks spreading out from where you hit
	for i = 1, 9 do
		local ang = (i / 9 + math.random() * 0.06) * math.pi * 2
		local len = 3 + math.random() * 4.5
		local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local crack = part({ Color = Color3.fromRGB(25, 25, 28), Material = Enum.Material.Slate, Transparency = 0,
			Size = Vector3.new(0.35 + math.random() * 0.3, 0.06, len) })
		crack.CFrame = CFrame.lookAt(ground + dir * (len / 2 + 0.6) + Vector3.new(0, 0.04, 0), ground + dir * 20 + Vector3.new(0, 0.04, 0))
		local glow = part({ Color = col, Transparency = 0.1, Size = Vector3.new(0.12, 0.08, len * 0.9) })
		glow.CFrame = crack.CFrame + Vector3.new(0, 0.02, 0)
		tweenOut(glow, 1.5, { Transparency = 1 })
		task.delay(2.2, function() if crack.Parent then tweenOut(crack, 1.2, { Transparency = 1 }) end end)
	end
	-- chunks of floor flung up
	for _ = 1, 12 do
		local sz = 0.35 + math.random() * 0.6
		local rock = newPart("Part", folder, { Material = Enum.Material.Slate, Color = floorCol:Lerp(Color3.new(0, 0, 0), 0.3),
			Size = Vector3.new(sz, sz * 0.8, sz), Transparency = 0 })
		rock.Anchored, rock.CanCollide = false, true
		local ang = math.random() * math.pi * 2
		rock.CFrame = CFrame.new(ground + Vector3.new(math.cos(ang), 0.6, math.sin(ang)) * 1.5) * CFrame.Angles(math.random(), math.random(), math.random())
		rock.AssemblyLinearVelocity = Vector3.new(math.cos(ang) * (10 + math.random() * 14), 22 + math.random() * 18, math.sin(ang) * (10 + math.random() * 14))
		rock.AssemblyAngularVelocity = Vector3.new(math.random() * 20 - 10, math.random() * 20 - 10, math.random() * 20 - 10)
		task.delay(2.4, function() if rock.Parent then tweenOut(rock, 0.8, { Transparency = 1 }) end end)
	end
	-- dust rolling out + sparks flying up
	local at = Instance.new("Attachment")
	local anchor = part({ Size = Vector3.new(1, 1, 1) })
	anchor.CFrame = CFrame.new(ground + Vector3.new(0, 0.5, 0))
	at.Parent = anchor
	local dust = make("ParticleEmitter", {
		Texture = TEX_SMOKE, Color = ColorSequence.new(floorCol:Lerp(WHITE, 0.5)), LightInfluence = 0.6, Brightness = 1,
		Size = NumberSequence.new({ kp(0, 2), kp(1, 6) }), Transparency = NumberSequence.new({ kp(0, 0.3), kp(1, 1) }),
		Lifetime = NumberRange.new(0.8, 1.6), Speed = NumberRange.new(18, 30), Drag = 3, Enabled = false,
		EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(85, 85),
		Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-60, 60),
	}, at)
	local sparks = make("ParticleEmitter", {
		Texture = TEX_SPARK, Color = ColorSequence.new(WHITE, col), LightEmission = 1, Brightness = 4, LightInfluence = 0,
		Orientation = Enum.ParticleOrientation.VelocityParallel, Squash = NumberSequence.new(2.5),
		Size = NumberSequence.new({ kp(0, 0.35), kp(1, 0) }), Lifetime = NumberRange.new(0.4, 0.9),
		Speed = NumberRange.new(25, 50), Drag = 2, Acceleration = Vector3.new(0, -30, 0), Enabled = false,
		EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(70, 70),
	}, at)
	dust:Emit(45)
	sparks:Emit(70)
	make("PointLight", { Color = col, Brightness = 6, Range = 22, Shadows = false }, at)
	tweenOut(at:FindFirstChildOfClass("PointLight"), 0.8, { Brightness = 0 })
	local boom = make("Sound", { SoundId = BOOM, Volume = 0.9, PlaybackSpeed = 0.8, RollOffMaxDistance = 150 }, anchor)
	boom:Play()
	-- your own screen shakes
	if character == Players.LocalPlayer.Character then
		self.shake = character:FindFirstChildOfClass("Humanoid")
	end
	return self
end

-- false once it's over
function Landing:Update(dt)
	self.t += dt
	if self.shake and self.shake.Parent then
		local k = math.max(0, 1 - self.t / 0.45)
		self.shake.CameraOffset = k > 0 and Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * 1.2 * k or Vector3.zero
	end
	if self.t >= LAND_TIME then
		self:Destroy()
		return false
	end
	return true
end

function Landing:ApplyPose()
	local w = smoothstep(0, 0.06, self.t) * (1 - smoothstep(LAND_TIME - 0.35, LAND_TIME, self.t))
	for key, j in pairs(self.motors) do
		local m = j.motor
		if m.Parent then
			local cur = m.Transform
			local base = (j.last and cur == j.last) and CFrame.identity or cur
			local out = base:Lerp(j.rot:Inverse() * LAND_POSE[key] * j.rot, w)
			if out ~= cur then m.Transform = out end
			j.last = out
		end
	end
end

function Landing:Destroy()
	for _, j in pairs(self.motors) do
		if j.last and j.motor.Parent and j.motor.Transform == j.last then j.motor.Transform = CFrame.identity end
	end
	self.motors = {}
	if self.shake and self.shake.Parent then self.shake.CameraOffset = Vector3.zero end
end

return Dragon
